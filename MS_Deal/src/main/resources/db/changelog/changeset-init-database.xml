<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="import_uuid_generator" author="robinx51">
        <sql>
            CREATE EXTENSION IF NOT EXISTS "uuid-ossp";
        </sql>
    </changeSet>
    <changeSet id="create_table_client" author="robinx51">
        <createTable tableName="client">
            <column name="client_id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" primaryKeyName="pk_client" nullable="false"/>
            </column>

            <column name="last_name" type="varchar(255)"/>

            <column name="first_name" type="varchar(255)"/>

            <column name="middle_name" type="varchar(255)"/>

            <column name="birth_date" type="date"/>

            <column name="email" type="varchar(255)"/>

            <column name="gender" type="varchar(255)"/>

            <column name="martial_status" type="varchar(255)"/>

            <column name="dependent_amount" type="integer"/>

            <column name="passport" type="jsonb"/>

            <column name="employment" type="jsonb"/>

            <column name="account_number" type="varchar(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="create_table_credit" author="robinx51">
        <createTable tableName="credit">
            <column name="credit_id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" primaryKeyName="pk_credit" nullable="false"/>
            </column>

            <column name="amount" type="numeric(38, 2)"/>

            <column name="term" type="integer"/>

            <column name="monthly_payment" type="numeric(38, 2)"/>

            <column name="rate" type="numeric(38, 2)"/>

            <column name="psk" type="numeric(38, 2)"/>

            <column name="payment_schedule" type="jsonb"/>

            <column name="insurance_enabled" type="boolean"/>

            <column name="salary_client" type="boolean"/>

            <column name="credit_status" type="character varying(255)"/>
        </createTable>
    </changeSet>
    <changeSet id="create_table_statement" author="robinx51">
        <createTable tableName="statement">
            <column name="statement_id" type="uuid" defaultValueComputed="uuid_generate_v4()">
                <constraints primaryKey="true" primaryKeyName="pk_statement" nullable="false"/>
            </column>

            <column name="client_id" type="uuid">
                <constraints foreignKeyName="fk_client_id" references="client(client_id)"/>
            </column>

            <column name="credit_id" type="uuid">
                <constraints foreignKeyName="fk_credit_id" references="credit(credit_id)"/>
            </column>

            <column name="status" type="character varying(255)"/>

            <column name="creation_date" type="timestamp without time zone"/>

            <column name="applied_offer" type="jsonb"/>

            <column name="sign_date" type="timestamp without time zone"/>

            <column name="ses_code" type="integer"/>

            <column name="status_history" type="jsonb"/>
        </createTable>
    </changeSet>
</databaseChangeLog>